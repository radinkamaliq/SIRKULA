# SIRKULA Environment Configuration
# Copy this file to .env and fill in your own values.
# Never commit .env to version control.

# Node environment
NODE_ENV=development
PORT=5000

# Application URL (used for safe redirects and cookie domain)
APP_URL=http://localhost:5000

# Session secret (generate a long random string, e.g. node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
SESSION_SECRET=change_this_to_a_long_random_secret_key_at_least_64_chars

# Session cookie settings
SESSION_COOKIE_NAME=sirkula_session
SESSION_COOKIE_SECURE=false        # set to true in production (HTTPS only)
SESSION_COOKIE_SAMESITE=Lax        # Lax | Strict | None
SESSION_COOKIE_MAX_AGE=86400000    # 24 hours in milliseconds

# PostgreSQL connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sirkula?schema=public"

# Bcrypt salt rounds
BCRYPT_SALT_ROUNDS=12

# CSRF token cookie name
CSRF_COOKIE_NAME=sirkula_csrf_token

# Upload limits (bytes)
MAX_FILE_SIZE=5242880              # 5 MB
UPLOAD_DIR=public/uploads

# CORS allowed origins (comma separated). Leave empty to disable CORS.
CORS_ORIGINS=http://localhost:5000
