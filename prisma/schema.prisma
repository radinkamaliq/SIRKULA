// SIRKULA — Prisma Schema
// Food redistribution platform database model
// Run: npx prisma generate  &&  npx prisma migrate deploy  &&  node prisma/seed.js

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  SELLER
  RECEIVER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum ListingStatus {
  AVAILABLE
  RESERVED
  UNAVAILABLE
  EXPIRED
}

enum ReservationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

enum NotificationType {
  RESERVATION_REQUEST
  RESERVATION_APPROVED
  RESERVATION_REJECTED
  RESERVATION_CANCELLED
  RESERVATION_COMPLETED
  LISTING_EXPIRED
  SYSTEM
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  phone     String?
  address   String?
  role      UserRole @default(RECEIVER)
  status    UserStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listings      FoodListing[]
  reservations  Reservation[]
  notifications Notification[]
  reports       Report[]
  auditLogs     AuditLog[]

  @@index([email])
  @@index([role])
  @@index([status])
}

model FoodListing {
  id             String        @id @default(cuid())
  title          String
  description    String?
  category       String
  quantity       Decimal
  availableQuantity Decimal
  unit           String
  condition      String        // e.g. "Fresh", "Near-expiry", "Packaged"
  price          Decimal?      // optional; null = free
  currency       String?       @default("IDR")

  sellerId       String
  seller         User          @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  pickupLocation String
  pickupLat      Decimal?
  pickupLng      Decimal?

  pickupDeadline DateTime

  images         String[]      @default([])   // stored file paths/URLs

  status         ListingStatus @default(AVAILABLE)

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  reservations   Reservation[]
  reports        Report[]
  notifications  Notification[]

  @@index([sellerId])
  @@index([status])
  @@index([category])
  @@index([pickupDeadline])
  @@index([createdAt])
}

model Reservation {
  id             String           @id @default(cuid())
  quantity       Decimal
  status         ReservationStatus @default(PENDING)
  notes          String?
  pickupInstructions String?

  listingId      String
  listing        FoodListing      @relation(fields: [listingId], references: [id], onDelete: Cascade)

  receiverId     String
  receiver       User             @relation(fields: [receiverId], references: [id], onDelete: Cascade)

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  distribution   DistributionRecord?
  notifications  Notification[]

  @@index([listingId])
  @@index([receiverId])
  @@index([status])
  @@index([createdAt])
}

model Notification {
  id             String          @id @default(cuid())
  title          String
  message        String
  type           NotificationType
  read           Boolean         @default(false)

  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  listingId      String?
  listing        FoodListing?    @relation(fields: [listingId], references: [id], onDelete: SetNull)

  reservationId  String?
  reservation    Reservation?    @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  createdAt      DateTime        @default(now())

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}

model Report {
  id          String       @id @default(cuid())
  reason      String
  description String?
  status      ReportStatus @default(PENDING)

  listingId   String
  listing     FoodListing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  reporterId  String
  reporter    User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  createdAt   DateTime     @default(now())

  @@index([listingId])
  @@index([reporterId])
  @@index([status])
}

model DistributionRecord {
  id               String   @id @default(cuid())
  quantityDistributed Decimal
  distributedAt    DateTime @default(now())
  notes            String?

  reservationId    String   @unique
  reservation      Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([distributedAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  targetType String?
  targetId  String?
  details   String?

  adminId   String?
  admin     User?    @relation(fields: [adminId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([createdAt])
  @@index([action])
}